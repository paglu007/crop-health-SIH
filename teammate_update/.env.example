# Crop Disease Risk Advisory System (SIH 2026)
# API Keys & Secrets Configuration

# OpenWeatherMap API Key (Required for live forecast & historical microclimate)
# Obtain free from: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=""

# Anthropic Claude API Key (Required for farmer-friendly advisory enrichment)
# Obtain from: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Claude Model identifier
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

# Database connection URL (Default SQLite file)
DATABASE_URL="sqlite:///crop_disease.db"

# Weather cache TTL in seconds (Default: 7200 seconds = 2 hours)
WEATHER_CACHE_TTL_SECONDS=7200

# Server Port
FLASK_PORT=5000
FLASK_DEBUG=True

# AI Studio runtime vars
GEMINI_API_KEY=""
APP_URL=""
