from pathlib import Path
import csv
import re


BASE_DIR = Path(__file__).resolve().parents[1]
DATASET_PATH = BASE_DIR / "plant_disease_advisory_dataset.csv"

CONFIDENCE_HIGH = 80.0
CONFIDENCE_MEDIUM = 60.0


def _clean_text(value):
    """Clean dataset text without changing its meaning."""
    if value is None:
        return ""

    text = str(value).strip()

    # Repair common spacing issues introduced by dataset formatting.
    text = re.sub(r"(?<=[a-z])(?=[A-Z])", " ", text)
    text = re.sub(r"\s+", " ", text)

    return text.strip()


def _load_knowledge_base():
    """Load the agricultural advisory knowledge base from CSV."""
    if not DATASET_PATH.exists():
        return []

    with DATASET_PATH.open(
        "r",
        encoding="utf-8-sig",
        newline=""
    ) as file:
        return list(csv.DictReader(file))


def _normalise(value):
    return _clean_text(value).lower().strip()


def _find_condition(crop, disease):
    """Find the closest supported crop/condition record."""
    rows = _load_knowledge_base()

    crop_key = _normalise(crop)
    disease_key = _normalise(disease)

    aliases = {
        "leaf blast": "blast",
        "bacterial leaf blight": "bacterial blight",
        "leaf scald": "leaf scald",
        "brown spot": "brown spot",
        "sheath blight": "sheath blight",
    }

    disease_key = aliases.get(disease_key, disease_key)

    for row in rows:
        row_crop = _normalise(row.get("crop"))
        row_disease = _normalise(row.get("disease_name"))

        if row_crop == crop_key and row_disease == disease_key:
            return row

    return None


def _risk_priority(risk_level):
    level = _normalise(risk_level)

    if level == "high":
        return "URGENT"

    if level == "medium":
        return "WARNING"

    return "NORMAL"


def _risk_advisory(row, risk_level):
    """Select the advisory text supplied by the knowledge base."""
    level = _normalise(risk_level)

    if level == "high":
        field = "high_risk_advisory"
    elif level == "medium":
        field = "medium_risk_advisory"
    else:
        field = "low_risk_advisory"

    advisory = _clean_text(row.get(field))

    if advisory:
        return advisory

    return (
        "Prioritize field inspection and follow the documented "
        "preventive and monitoring measures for this condition."
    )


def _risk_action(risk_level):
    level = _normalise(risk_level)

    if level == "high":
        return (
            "Prioritize prompt field inspection and management "
            "of visibly affected areas."
        )

    if level == "medium":
        return (
            "Inspect the affected area regularly and prioritize "
            "early management if symptoms increase."
        )

    return (
        "Continue routine monitoring and apply preventive "
        "field-management practices."
    )


def _weather_context(weather, row):
    """Explain weather factors without changing the supplied risk."""
    if not isinstance(weather, dict):
        return []

    context = []

    humidity = weather.get("humidity_pct")
    temperature = weather.get("temp_c")
    rainfall = weather.get("rainfall_mm")

    favorable = _clean_text(row.get("favorable_conditions"))

    if humidity is not None:
        try:
            humidity_value = float(humidity)

            if humidity_value >= 80:
                message = (
                    "Current humidity is high and may support the "
                    "favorable conditions listed for this condition."
                )
            else:
                message = (
                    "Current humidity is %.1f%%; compare this with "
                    "the favorable conditions for the condition."
                ) % humidity_value

            context.append(message)
        except (TypeError, ValueError):
            pass

    if rainfall is not None:
        try:
            rainfall_value = float(rainfall)

            if rainfall_value > 0:
                context.append(
                    "Recent rainfall can increase leaf wetness and "
                    "may support disease spread."
                )
        except (TypeError, ValueError):
            pass

    if temperature is not None:
        try:
            temperature_value = float(temperature)
            context.append(
                "Current temperature is %.1f°C." % temperature_value
            )
        except (TypeError, ValueError):
            pass

    if favorable:
        context.append(
            "Knowledge-base favorable conditions: %s" % favorable
        )

    return context


def _healthy_advisory(crop, confidence, risk_level, risk_score, weather):
    """Return advisory for a healthy crop image."""
    return {
        "priority": _risk_priority(risk_level),
        "risk_level": risk_level,
        "risk_score": risk_score,
        "issue": "Healthy",
        "confidence": confidence,
        "condition_status": (
            "The image model identified the crop as a healthy rice leaf."
        ),
        "severity_interpretation": (
            "No supported disease condition was identified by the "
            "image model. Continue routine crop monitoring."
        ),
        "symptoms": [],
        "likely_cause": "No disease condition identified.",
        "recommendations": [
            "Continue routine field inspection.",
            "Maintain good field sanitation and crop-management practices."
        ],
        "weather_context": [],
        "prevention": [
            "Use certified disease-free planting material.",
            "Maintain field sanitation and avoid unnecessarily dense planting."
        ],
        "organic_options": [],
        "monitoring": [
            "Continue monitoring leaves for new spots, discoloration, "
            "lesions, or other changes."
        ],
        "expert_advisory": (
            "Consult a local agricultural extension officer if new "
            "symptoms appear or crop health changes unexpectedly."
        ),
        "chemical_treatment_note": (
            "No disease-specific chemical treatment is recommended "
            "for a healthy diagnosis."
        ),
    }


def _low_confidence_advisory(
    crop,
    disease,
    confidence,
    risk_level,
    risk_score,
):
    """Avoid disease-specific recommendations when confidence is low."""
    return {
        "priority": _risk_priority(risk_level),
        "risk_level": risk_level,
        "risk_score": risk_score,
        "issue": disease,
        "confidence": confidence,
        "condition_status": (
            "The image model confidence is too low for a reliable "
            "disease-specific recommendation."
        ),
        "severity_interpretation": (
            "The supplied risk-engine result is preserved, but the "
            "image diagnosis should be confirmed before making "
            "condition-specific management decisions."
        ),
        "symptoms": [],
        "likely_cause": "Unconfirmed.",
        "recommendations": [
            "Capture a clearer image showing the affected leaf or plant.",
            "Inspect several representative plants in the field.",
            "Avoid making disease-specific treatment decisions "
            "from this low-confidence image alone."
        ],
        "weather_context": [],
        "prevention": [
            "Continue routine field sanitation and crop monitoring."
        ],
        "organic_options": [],
        "monitoring": [
            "Monitor whether visible symptoms increase or spread."
        ],
        "expert_advisory": (
            "If symptoms persist or worsen, consult a local agricultural "
            "extension officer or plant pathologist for confirmation."
        ),
        "chemical_treatment_note": (
            "Do not make chemical treatment decisions from a "
            "low-confidence image diagnosis. Consult the local "
            "agricultural extension/agriculture department."
        ),
    }


def generate_advisory(
    crop,
    disease,
    confidence,
    risk_level,
    risk_score=None,
    weather=None,
):
    """
    Generate a structured advisory from the agricultural knowledge base.

    IMPORTANT:
    risk_level and risk_score are supplied by the external risk engine.
    This function does not calculate, override, or modify them.
    """
    try:
        confidence_value = float(confidence)
    except (TypeError, ValueError):
        confidence_value = 0.0

    risk_level_clean = str(risk_level or "LOW").upper()

    try:
        if risk_score is not None:
            risk_score_value = float(risk_score)
        else:
            risk_score_value = None
    except (TypeError, ValueError):
        risk_score_value = None

    if _normalise(disease) in {
        "healthy rice leaf",
        "healthy",
    }:
        return _healthy_advisory(
            crop,
            confidence_value,
            risk_level_clean,
            risk_score_value,
            weather,
        )

    if confidence_value < CONFIDENCE_MEDIUM:
        return _low_confidence_advisory(
            crop,
            disease,
            confidence_value,
            risk_level_clean,
            risk_score_value,
        )

    row = _find_condition(crop, disease)

    if row is None:
        return {
            "priority": _risk_priority(risk_level_clean),
            "risk_level": risk_level_clean,
            "risk_score": risk_score_value,
            "issue": disease,
            "confidence": confidence_value,
            "condition_status": (
                "Condition recognized by the image model, but "
                "matching advisory data is unavailable in the "
                "knowledge base."
            ),
            "severity_interpretation": (
                "Use the supplied risk-engine result to determine "
                "management priority while confirming the condition "
                "in the field."
            ),
            "symptoms": [],
            "likely_cause": "Advisory knowledge unavailable.",
            "recommendations": [
                _risk_action(risk_level_clean),
                "Confirm the diagnosis through field inspection."
            ],
            "weather_context": [],
            "prevention": [
                "Maintain good field sanitation and regular monitoring."
            ],
            "organic_options": [],
            "monitoring": [
                "Monitor the affected plants for progression or spread."
            ],
            "expert_advisory": (
                "Consult a local agricultural extension officer or "
                "plant pathologist because condition-specific advisory "
                "data is unavailable."
            ),
            "chemical_treatment_note": (
                "For chemical treatment decisions, consult the local "
                "agricultural extension/agriculture department for a "
                "currently approved product and application guidance "
                "appropriate to the crop and location."
            ),
        }

    symptoms = _clean_text(row.get("symptoms"))
    pathogen = _clean_text(row.get("pathogen_type"))
    prevention = _clean_text(row.get("preventive_measures"))
    organic = _clean_text(row.get("organic_treatment"))
    expert = _clean_text(row.get("expert_advisory"))

    recommendations = [
        _risk_advisory(row, risk_level_clean),
        _risk_action(risk_level_clean),
    ]

    # At medium confidence, keep the advisory useful but explicitly
    # require confirmation before major decisions.
    if confidence_value < CONFIDENCE_HIGH:
        recommendations.append(
            "Because model confidence is moderate, confirm the "
            "condition in the field before making major management decisions."
        )

    monitoring = [
        "Monitor the %s crop regularly for changes in the visible symptoms."
        % _clean_text(crop),
    ]

    if symptoms:
        monitoring.append(
            "Look for progression of the documented symptoms: %s" % symptoms
        )

    weather_context = _weather_context(weather, row)

    return {
        "priority": _risk_priority(risk_level_clean),
        "risk_level": risk_level_clean,
        "risk_score": risk_score_value,
        "issue": _clean_text(disease),
        "confidence": round(confidence_value, 2),
        "condition_status": (
            "Disease/condition identified by the image model."
        ),
        "severity_interpretation": (
            "The image model has %s confidence in the identified "
            "condition. Use the supplied risk-engine result together "
            "with field inspection to determine management priority."
            % (
                "high"
                if confidence_value >= CONFIDENCE_HIGH
                else "moderate"
            )
        ),
        "symptoms": symptoms,
        "likely_cause": pathogen,
        "recommendations": recommendations,
        "weather_context": weather_context,
        "prevention": [prevention] if prevention else [],
        "organic_options": [organic] if organic else [],
        "monitoring": monitoring,
        "expert_advisory": expert or (
            "Consult a local agricultural extension officer or plant "
            "pathologist if symptoms persist or worsen."
        ),
        "chemical_treatment_note": (
            "For chemical treatment decisions, consult the local "
            "agricultural extension/agriculture department for a "
            "currently approved product and application guidance "
            "appropriate to the crop and location."
        ),
    }
